# Mounted volume paths (override for ECS task definitions)
POLICIES_PATH=./policies/policies.yaml
STATE_PATH=./state/mode.json
LOGS_PATH=./logs/audit.log
CREDENTIALS_PATH=./data/credentials.json

# OAuth broker: encrypted connections store + the fixed localhost callback port.
# The redirect URI you register with each provider must be
# http://localhost:<OAUTH_REDIRECT_PORT>/callback (default port 8765).
CONNECTIONS_PATH=./data/connections.json
OAUTH_REDIRECT_PORT=8765

# Registered agent identities (encrypted digests of agent keys issued by
# `agentgate agent-add <name>`; the keys themselves are never stored).
AGENTS_PATH=./data/agents.json

# Where the MCP server listens (HTTP transport). Agents connect to
# http://<MCP_HOST>:<MCP_PORT>/mcp — keep the host on loopback unless you
# front it with real network access control.
MCP_HOST=127.0.0.1
MCP_PORT=8848

# Set these ONLY when running `agentgate connect <provider>` (read at connect time,
# stored encrypted with the connection; never passed as a command-line argument):
# AGENTGATE_OAUTH_CLIENT_ID=
# AGENTGATE_OAUTH_CLIENT_SECRET=

# Seconds to wait for operator approval on an escalated request before
# failing closed (denying). 0 or any value <= 0 = disabled (wait indefinitely) — the default,
# matching interactive CLI use. Set > 0 for headless/unattended deployments.
ESCALATION_TIMEOUT_SECONDS=0

# Master password for credential encryption.
# If unset, the broker prompts interactively at startup.
AGENTGATE_MASTER_PASSWORD=
